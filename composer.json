{
    "name": "hangtuah/laravel-code-auditor",
    "description": "Local Laravel audit of potentially unused methods and their Git origin",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/support": "^13.43",
        "illuminate/routing": "^13.43",
        "illuminate/view": "^13.43",
        "symfony/process": "^8.0"
    },
    "autoload": {"psr-4": {"LaravelCodeAuditor\\": "src/"}},
    "extra": {"laravel": {"providers": ["LaravelCodeAuditor\\CodeAuditorServiceProvider"]}}
}
